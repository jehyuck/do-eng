      },
      "entrypoint": null,
      "image": "nicolaka/netshoot:v0.13",
      "network_mode": "service:experiment-mock",
      "volumes": [
        {
          "type": "bind",
          "source": "D:\\T7\\workspace\\_작업공간\\50_로컬레포\\active\\projects\\jehyuck\\do-eng\\backend\\experiments\\results\\experiment-1-19\\preflight\\collector-probe/mock",
          "target": "/capture"
        }
      ]
    },
    "experiment-mock": {
      "cpus": 4,
      "command": null,
      "entrypoint": null,
      "environment": {
        "MOCK_AI_DELAY_MS": "0",
        "MOCK_AI_RESULT": "false",
        "MOCK_AI_STATUS": "200",
        "MOCK_MEMBER_ID": "15",
