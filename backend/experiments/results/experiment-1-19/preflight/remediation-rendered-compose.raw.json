  "services": {
    "camera-measure": {
      "command": [
        "node",
        "server.js"
      ],
      "entrypoint": null,
      "environment": {
        "CAPTURE_HOST": "0.0.0.0",
        "CAPTURE_PORT": "9200"
      },
      "image": "node:20-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 9200,
          "published": "9200",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "D:\\T7\\workspace\\_작업공간\\50_로컬레포\\active\\projects\\jehyuck\\do-eng\\experiment\\capture",
          "target": "/app",
          "read_only": true,
          "bind": {}
        }
      ],
      "working_dir": "/app"
    },
    "capture-application": {
      "cap_add": [
        "NET_RAW",
        "NET_ADMIN"
      ],
      "command": [
        "sh",
        "-lc",
        "exec tcpdump -i any -nn -s 96 -U -Z root -w /capture/application-control.pcap 'tcp port 9100 and (tcp[tcpflags] \u0026 (tcp-syn|tcp-fin|tcp-rst) != 0)'"
      ],
      "depends_on": {
        "flux-corrected": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "nicolaka/netshoot:v0.13",
      "network_mode": "service:flux-corrected",
      "volumes": [
        {
          "type": "bind",
          "source": "D:\\T7\\workspace\\_작업공간\\50_로컬레포\\active\\projects\\jehyuck\\do-eng\\backend\\experiments\\results\\experiment-1-19\\preflight\\collector-probe/application",
          "target": "/capture"
        }
      ]
    },
    "capture-mock": {
      "cap_add": [
        "NET_RAW",
        "NET_ADMIN"
      ],
      "command": [
        "sh",
        "-lc",
        "exec tcpdump -i any -nn -s 96 -U -Z root -w /capture/mock-control.pcap 'tcp port 9100 and (tcp[tcpflags] \u0026 (tcp-syn|tcp-fin|tcp-rst) != 0)'"
      ],
      "depends_on": {
        "experiment-mock": {
          "condition": "service_started",
          "required": true
